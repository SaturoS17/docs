{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CBPay",
  "description": "CBPay developer documentation - fiat payouts and collections across Latin America, internal transfers, on-chain USDT and KYC.",
  "colors": {
    "primary": "#A16207",
    "light": "#FBC140",
    "dark": "#2E2E2E"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "dark": "#1C1C1C"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "search": {
    "prompt": "Search the docs / Busca en la documentación..."
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "cbpayapp.com",
      "href": "https://cbpayapp.com"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "es",
        "tabs": [
          {
            "tab": "Guías",
            "groups": [
              {
                "group": "Comenzar",
                "pages": [
                  "es/introduccion",
                  "es/inicio-rapido",
                  "es/autenticacion",
                  "es/guias/login-social",
                  "es/entorno-y-pruebas"
                ]
              },
              {
                "group": "Conceptos",
                "pages": [
                  "es/conceptos/modelo-de-dinero",
                  "es/conceptos/comisiones",
                  "es/conceptos/idempotencia",
                  "es/conceptos/personas-y-empresas",
                  "es/conceptos/servicios",
                  "es/conceptos/estados",
                  "es/conceptos/movimientos-y-conciliacion"
                ]
              },
              {
                "group": "Flujos de integración",
                "pages": [
                  "es/flujos"
                ]
              },
              {
                "group": "Productos",
                "pages": [
                  "es/guias/payouts",
                  "es/guias/payins",
                  "es/guias/transferencias",
                  "es/guias/crypto",
                  "es/guias/tarjetas",
                  "es/guias/banking",
                  "es/guias/kyc",
                  "es/guias/cartola"
                ]
              },
              {
                "group": "Integración",
                "pages": [
                  "es/seguridad-2fa",
                  "es/webhooks",
                  "es/errores",
                  "es/faq"
                ]
              },
              {
                "group": "Recursos",
                "pages": [
                  "es/postman",
                  "es/changelog"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "openapi": "openapi.es.yaml"
          }
        ]
      },
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "en/introduction",
                  "en/quickstart",
                  "en/authentication",
                  "en/guides/social-login",
                  "en/environment-testing"
                ]
              },
              {
                "group": "Concepts",
                "pages": [
                  "en/concepts/money-model",
                  "en/concepts/fees",
                  "en/concepts/idempotency",
                  "en/concepts/persons-companies",
                  "en/concepts/services",
                  "en/concepts/statuses",
                  "en/concepts/movements-reconciliation"
                ]
              },
              {
                "group": "Integration flows",
                "pages": [
                  "en/flows"
                ]
              },
              {
                "group": "Products",
                "pages": [
                  "en/guides/payouts",
                  "en/guides/payins",
                  "en/guides/transfers",
                  "en/guides/crypto",
                  "en/guides/cards",
                  "en/guides/banking",
                  "en/guides/kyc",
                  "en/guides/statement"
                ]
              },
              {
                "group": "Integration",
                "pages": [
                  "en/security-2fa",
                  "en/webhooks",
                  "en/errors",
                  "en/faq"
                ]
              },
              {
                "group": "Resources",
                "pages": [
                  "en/postman",
                  "en/changelog"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "openapi": "openapi.yaml"
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://cbpayapp.com"
    }
  },
  "redirects": [
    {
      "source": "/es/guias/payouts-por-pais",
      "destination": "/es/guias/payouts"
    },
    {
      "source": "/es/guias/payins-por-pais",
      "destination": "/es/guias/payins"
    },
    {
      "source": "/en/guides/payouts-by-country",
      "destination": "/en/guides/payouts"
    },
    {
      "source": "/en/guides/payins-by-country",
      "destination": "/en/guides/payins"
    }
  ]
}
