{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CBPay",
  "description": "CBPay developer documentation - fiat payouts and collections across Latin America, internal transfers, on-chain USDT and KYC.",
  "colors": {
    "primary": "#A16207",
    "light": "#FBC140",
    "dark": "#2E2E2E"
  },
